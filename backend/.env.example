HF_CLIENT_ID=hf_clientid_your_id_here
HF_CLIENT_SECRET=hf_secret_your_secret_here
HF_REDIRECT_URI=https://yourdomain.com/auth/callback
SESSION_SECRET=replace_with_64_char_random_hex_string
FRONTEND_URL=https://yourdomain.com
ENV=production

# DEV ONLY — inject extra group IDs into every logged-in user's groups list.
# Use this to test group-gated UI (group assets dropdown, group forum access, etc.)
# without being a member. Comma-separated group IDs. Remove or leave empty in production.
# Example: all known member group IDs
# DEV_GROUPS_OVERRIDE=12,23,39,46,48,49,50,52,53,54,56,57,59,63,68,70,71,74,77,78
