HF_CLIENT_ID=hf_clientid_your_id_here
HF_CLIENT_SECRET=hf_secret_your_secret_here
HF_REDIRECT_URI=https://yourdomain.com/auth/callback
SESSION_SECRET=replace_with_64_char_random_hex_string
FRONTEND_URL=https://yourdomain.com
ENV=production

# TOKEN_ENCRYPT_KEY=   generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# DB_PATH=data/hf_dash.db

# DB_HOST=
# DB_PORT=3306
# DB_USER=hftoolbox
# DB_PASSWORD=change_me
# DB_NAME=hftoolbox

# PLATFORM_OWNER_UID=

# HF controller. The secret must exist only in runtime env, never in Git.
# HF_CONTROL_PLANE_URL=http://host.docker.internal:38311
# HF_CONTROL_PLANE_CALLER=prod
# HF_CONTROL_PLANE_SECRET=

# Telegram alerts (optional)
# Create a bot with @BotFather and paste the token here to enable Telegram alerts.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_USERNAME=   <- bot username without @, used to build t.me deep links
# TELEGRAM_WEBHOOK_SECRET= <- random string; generate with: python -c "import secrets; print(secrets.token_hex(32))"

